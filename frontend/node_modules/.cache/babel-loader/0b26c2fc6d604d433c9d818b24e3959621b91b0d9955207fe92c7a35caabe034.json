{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.for-each.js\";\nimport { defineComponent, ref } from \"vue\";\nexport default defineComponent({\n  setup() {\n    const selectedSlot = ref(null);\n    const days = ref(Array.from({\n      length: 5\n    }, (_, i) => {\n      const date = new Date();\n      date.setDate(date.getDate() + i);\n      return {\n        date,\n        slots: [{\n          time: \"9:00 AM\",\n          selected: false\n        }, {\n          time: \"10:00 AM\",\n          selected: false\n        }, {\n          time: \"11:00 AM\",\n          selected: false\n        }, {\n          time: \"1:00 PM\",\n          selected: false\n        }, {\n          time: \"2:00 PM\",\n          selected: false\n        }]\n      };\n    }));\n    const selectSlot = (day, slot) => {\n      // Deselect all slots\n      days.value.forEach(d => d.slots.forEach(s => {\n        s.selected = false;\n      }));\n\n      // Select the clicked slot\n      slot.selected = true;\n\n      // Update the selected slot\n      selectedSlot.value = {\n        date: day.date,\n        time: slot.time\n      };\n    };\n    const formatDate = date => {\n      const options = {\n        weekday: \"short\",\n        month: \"short\",\n        day: \"numeric\"\n      };\n      return new Intl.DateTimeFormat(\"en-US\", options).format(date);\n    };\n    return {\n      days,\n      selectedSlot,\n      selectSlot,\n      formatDate\n    };\n  }\n});","map":{"version":3,"names":["defineComponent","ref","setup","selectedSlot","days","Array","from","length","_","i","date","Date","setDate","getDate","slots","time","selected","selectSlot","day","slot","value","forEach","d","s","formatDate","options","weekday","month","Intl","DateTimeFormat","format"],"sources":["/Users/laura/flossy/calendar/src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <h1>Simple Meeting Selector</h1>\n    <div class=\"calendar\">\n      <div v-for=\"day in days\" :key=\"day.date\" class=\"day\">\n        <h3>{{ formatDate(day.date) }}</h3>\n        <div class=\"slots\">\n          <button\n            v-for=\"slot in day.slots\"\n            :key=\"slot.time\"\n            :class=\"{ selected: slot.selected }\"\n            @click=\"selectSlot(day, slot)\"\n          >\n            {{ slot.time }}\n          </button>\n        </div>\n      </div>\n    </div>\n    <div v-if=\"selectedSlot\">\n      <h2>Selected Slot</h2>\n      <p>\n        Date: {{ formatDate(selectedSlot.date) }} <br />\n        Time: {{ selectedSlot.time }}\n      </p>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { defineComponent, ref } from \"vue\";\n\nexport default defineComponent({\n  setup() {\n    const selectedSlot = ref(null);\n\n    const days = ref(\n      Array.from({ length: 5 }, (_, i) => {\n        const date = new Date();\n        date.setDate(date.getDate() + i);\n        return {\n          date,\n          slots: [\n            { time: \"9:00 AM\", selected: false },\n            { time: \"10:00 AM\", selected: false },\n            { time: \"11:00 AM\", selected: false },\n            { time: \"1:00 PM\", selected: false },\n            { time: \"2:00 PM\", selected: false },\n          ],\n        };\n      })\n    );\n\n    const selectSlot = (day, slot) => {\n      // Deselect all slots\n      days.value.forEach((d) =>\n        d.slots.forEach((s) => {\n          s.selected = false;\n        })\n      );\n\n      // Select the clicked slot\n      slot.selected = true;\n\n      // Update the selected slot\n      selectedSlot.value = {\n        date: day.date,\n        time: slot.time,\n      };\n    };\n\n    const formatDate = (date) => {\n      const options = { weekday: \"short\", month: \"short\", day: \"numeric\" };\n      return new Intl.DateTimeFormat(\"en-US\", options).format(date);\n    };\n\n    return {\n      days,\n      selectedSlot,\n      selectSlot,\n      formatDate,\n    };\n  },\n});\n</script>\n\n<style scoped>\n#app {\n  font-family: \"Avenir\", Helvetica, Arial, sans-serif;\n  text-align: center;\n  margin: 20px;\n}\n\n.calendar {\n  display: flex;\n  justify-content: center;\n  gap: 20px;\n}\n\n.day {\n  border: 1px solid #ddd;\n  padding: 10px;\n  border-radius: 5px;\n  background: #f9f9f9;\n  width: 150px;\n}\n\nh3 {\n  font-size: 1.2rem;\n  margin-bottom: 10px;\n}\n\n.slots {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\nbutton {\n  padding: 5px 10px;\n  border: 1px solid #ddd;\n  border-radius: 3px;\n  background: #fff;\n  cursor: pointer;\n  transition: 0.3s;\n}\n\nbutton:hover {\n  background: #eef;\n}\n\nbutton.selected {\n  background: #add8e6;\n  border-color: #00f;\n  color: #000;\n}\n</style>\n"],"mappings":";;AA6BA,SAASA,eAAe,EAAEC,GAAE,QAAS,KAAK;AAE1C,eAAeD,eAAe,CAAC;EAC7BE,KAAKA,CAAA,EAAG;IACN,MAAMC,YAAW,GAAIF,GAAG,CAAC,IAAI,CAAC;IAE9B,MAAMG,IAAG,GAAIH,GAAG,CACdI,KAAK,CAACC,IAAI,CAAC;MAAEC,MAAM,EAAE;IAAE,CAAC,EAAE,CAACC,CAAC,EAAEC,CAAC,KAAK;MAClC,MAAMC,IAAG,GAAI,IAAIC,IAAI,CAAC,CAAC;MACvBD,IAAI,CAACE,OAAO,CAACF,IAAI,CAACG,OAAO,CAAC,IAAIJ,CAAC,CAAC;MAChC,OAAO;QACLC,IAAI;QACJI,KAAK,EAAE,CACL;UAAEC,IAAI,EAAE,SAAS;UAAEC,QAAQ,EAAE;QAAM,CAAC,EACpC;UAAED,IAAI,EAAE,UAAU;UAAEC,QAAQ,EAAE;QAAM,CAAC,EACrC;UAAED,IAAI,EAAE,UAAU;UAAEC,QAAQ,EAAE;QAAM,CAAC,EACrC;UAAED,IAAI,EAAE,SAAS;UAAEC,QAAQ,EAAE;QAAM,CAAC,EACpC;UAAED,IAAI,EAAE,SAAS;UAAEC,QAAQ,EAAE;QAAM,CAAC;MAExC,CAAC;IACH,CAAC,CACH,CAAC;IAED,MAAMC,UAAS,GAAIA,CAACC,GAAG,EAAEC,IAAI,KAAK;MAChC;MACAf,IAAI,CAACgB,KAAK,CAACC,OAAO,CAAEC,CAAC,IACnBA,CAAC,CAACR,KAAK,CAACO,OAAO,CAAEE,CAAC,IAAK;QACrBA,CAAC,CAACP,QAAO,GAAI,KAAK;MACpB,CAAC,CACH,CAAC;;MAED;MACAG,IAAI,CAACH,QAAO,GAAI,IAAI;;MAEpB;MACAb,YAAY,CAACiB,KAAI,GAAI;QACnBV,IAAI,EAAEQ,GAAG,CAACR,IAAI;QACdK,IAAI,EAAEI,IAAI,CAACJ;MACb,CAAC;IACH,CAAC;IAED,MAAMS,UAAS,GAAKd,IAAI,IAAK;MAC3B,MAAMe,OAAM,GAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,KAAK,EAAE,OAAO;QAAET,GAAG,EAAE;MAAU,CAAC;MACpE,OAAO,IAAIU,IAAI,CAACC,cAAc,CAAC,O